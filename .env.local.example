# Campus Sandbox — copy to .env.local and fill in from your Supabase project.
# Never commit .env.local (it is gitignored by default).

# Project Settings → API → Project URL (bare URL, no /rest/v1/ suffix)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Project Settings → API → anon public key (safe to expose to browsers)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Project Settings → API → service_role key (SECRET — server + seed scripts only)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Project Settings → Database → Connection string (session pooler URI).
# Used only by scripts/apply-schema.mjs. Percent-encode special characters
# in the password (e.g. ! → %21, $ → %24).
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-ENCODED-PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres
